{
  "pages": ["pages/home/index", "pages/community/index", "pages/message/index", "pages/my/index"],
  "usingComponents": {
    "t-toast": "tdesign-miniprogram/toast/toast"
  },
  "subpackages": [
    {
      "root": "pages/search",
      "name": "search",
      "pages": ["index"]
    },
    {
      "root": "pages/message/detail",
      "name": "message-detail",
      "pages": ["index"]
    },
    {
      "root": "pages/roulette",
      "name": "roulette",
      "pages": ["index"]
    },
    {
      "root": "pages/comments",
      "name": "comments",
      "pages": ["index"]
    },
    {
      "root": "pages/profile",
      "name": "profile",
      "pages": ["index"]
    },
    {
      "root": "pages/social",
      "name": "social",
      "pages": ["list/index", "privacy/index", "history/index"]
    },
    {
      "root": "pages/checkins",
      "name": "checkins",
      "pages": ["index"]
    },
    {
      "root": "pages/weeklyInsights",
      "name": "weekly-insights",
      "pages": ["index"]
    },
    {
      "root": "pages/my/info-edit",
      "name": "edit",
      "pages": ["index"]
    },
    {
      "root": "pages/chat",
      "name": "chat",
      "pages": ["index"]
    },
    {
      "root": "pages/login",
      "name": "login",
      "pages": ["login"]
    },
    {
      "root": "pages/dataCenter",
      "name": "dataCenter",
      "pages": ["index"]
    },
    {
      "root": "pages/setting",
      "name": "setting",
      "pages": ["index"]
    },
    {
      "root": "pages/release",
      "name": "release",
      "pages": ["index"]
    },
    {
      "root": "pages/admin",
      "name": "admin",
      "pages": ["login/index", "posts/index"]
    },
    {
      "root": "pages/legal",
      "name": "legal",
      "pages": ["agreement/index", "privacy/index"]
    }
  ],
  "window": {
    "backgroundTextStyle": "light",
    "navigationBarBackgroundColor": "#fff",
    "navigationBarTitleText": "Weixin",
    "navigationBarTextStyle": "black"
  },
  "tabBar": {
    "custom": true,
    "list": [
      {
        "pagePath": "pages/home/index",
        "text": "首页"
      },
      {
        "pagePath": "pages/community/index",
        "text": "社区"
      },
      {
        "pagePath": "pages/message/index",
        "text": "消息"
      },
      {
        "pagePath": "pages/my/index",
        "text": "我的"
      }
    ]
  },
  "resolveAlias": {
    "~/*": "/*"
  },
  "permission": {
    "scope.userLocation": {
      "desc": "用于在用户主动开启分享位置时选择帖子展示地点"
    }
  },
  "requiredPrivateInfos": ["chooseLocation"],
  "sitemapLocation": "sitemap.json"
}
