<view class="figma-nav-shell {{appearanceClass}}">
  <view class="figma-nav">
    <view
      wx:for="{{items}}"
      wx:key="key"
      class="figma-nav__item {{active === item.key ? 'figma-nav__item--active' : ''}}"
      data-key="{{item.key}}"
      data-url="{{item.url}}"
      bindtap="changePage"
      role="button"
      aria-label="{{item.label}}"
    >
      <image class="figma-nav__icon" src="{{active === item.key ? item.activeIcon : item.icon}}" mode="aspectFit" aria-hidden="true" />
    </view>
  </view>
</view>
