<view class="canteen-page {{appearanceClass}}">
  <scroll-view class="canteen-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="page-head"><text class="page-head__title">食堂与菜品</text><text class="page-head__desc">沿着校园的气味，找一顿刚刚好的饭。</text></view>
    <view class="search-box" bindtap="goSearch"><text>搜索食堂、菜名或一种念头…</text></view>
    <scroll-view class="quick-chips" scroll-x show-scrollbar="{{false}}"><view wx:for="{{filters}}" wx:key="*this" class="{{activeFilter === item ? 'active' : ''}}" data-value="{{item}}" bindtap="selectFilter">{{index === 0 ? '⌾' : index === 4 ? '◷' : '♙'}} {{item}}</view></scroll-view>
    <view class="map-card" bindtap="openCampusMap"><image src="/static/figma/campus-map.webp" mode="aspectFill"/><view class="map-caption"><text>开饭地图</text><text>玉泉校区 · 点击查看</text></view></view>
    <view class="section-title"><text>此刻值得去</text><text bindtap="openRanking">{{dishes.length}} 个去处 · {{ranked ? '推荐顺序' : '评分排序'}}</text></view>
    <view class="dish-list"><view class="dish {{index === 1 ? 'dish--green' : ''}}" wx:for="{{dishes}}" wx:key="id" data-index="{{index}}" bindtap="openDish"><image src="{{item.image}}" mode="aspectFit"/><view><text>{{item.canteen || item.place}}</text><text>{{item.name}} · {{item.price}}</text></view><text>★ {{item.score}}</text></view></view>
    <view wx:if="{{!dishes.length}}" class="section-title"><text>暂时没有符合条件的菜品</text></view>
    <view class="bottom-space"></view>
  </scroll-view><figma-nav active="canteen" />
</view>
