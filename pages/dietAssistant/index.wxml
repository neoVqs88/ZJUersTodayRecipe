<view class="assistant-page">
  <view class="assistant-head"><view class="back" bindtap="goBack">‹</view><view><text>饮食健康助手</text><text>只聊饮食、营养与食品安全</text></view><view class="head-mark">AI</view></view>
  <scroll-view class="message-list" scroll-y scroll-into-view="last-message">
    <view wx:if="{{messages.length === 1}}" class="suggestions"><text>你可以这样问</text><view wx:for="{{suggestions}}" wx:key="*this" class="suggestion" data-question="{{item}}" bindtap="askSuggestion">{{item}}　›</view></view>
    <view wx:for="{{messages}}" wx:key="index" id="{{index === messages.length - 1 ? 'last-message' : ''}}" class="message-row {{item.role}}"><view class="message-bubble">{{item.content}}</view></view>
    <view wx:if="{{sending}}" class="message-row assistant"><view class="message-bubble typing">正在思考…</view></view>
  </scroll-view>
  <view class="disclaimer">内容仅供健康管理参考，不能替代专业医疗建议。</view>
  <view class="composer"><input value="{{input}}" maxlength="300" confirm-type="send" placeholder="问问你的饮食问题" bindinput="onInput" bindconfirm="onConfirm" /><button disabled="{{sending || !input}}" bindtap="sendMessage">发送</button></view>
</view>
