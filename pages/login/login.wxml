<t-navbar left-arrow title="账号登录" />
<view class="page login">
  <view class="login__brand">
    <view class="login__logo">zjuer</view>
    <view class="login__title">今天吃什么</view>
    <view class="login__subtitle">发现校园美食，记录每一餐</view>
  </view>

  <view class="login__panel">
    <t-button block icon="logo-wechat-stroke" loading="{{loadingType === 'wechat'}}" size="large" theme="primary" bindtap="loginWithWechat">
      微信快捷登录
    </t-button>

    <view class="login__divider"><text>或使用手机号验证码登录</text></view>
    <view class="login__phone">
      <t-input borderless maxlength="11" placeholder="请输入手机号" type="number" value="{{phoneNumber}}" bindchange="onPhoneInput">
        <view slot="label" class="login__prefix">+86</view>
      </t-input>
    </view>
    <t-button block disabled="{{!isPhoneNumber}}" loading="{{loadingType === 'sms'}}" size="large" theme="primary" variant="outline" bindtap="sendCode">
      获取短信验证码
    </t-button>
    <view class="login__tip">未注册的手机号验证后将自动创建账号</view>
  </view>

  <view class="login__agreement">
    <t-radio-group allow-uncheck borderless value="{{agreed ? 'agree' : ''}}" bind:change="onAgreementChange">
      <t-radio value="agree" t-class="agreement-radio" />
    </t-radio-group>
    <text>我已阅读并同意</text>
    <text class="login__link" data-type="agreement" bindtap="showAgreement">《用户协议》</text>
    <text>和</text>
    <text class="login__link" data-type="privacy" bindtap="showAgreement">《隐私政策》</text>
  </view>
</view>
<t-toast id="login-toast" />
