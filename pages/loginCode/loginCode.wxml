<t-navbar left-arrow title="短信验证" />
<view class="page login-code">
  <view class="login-code__title">输入验证码</view>
  <view class="login-code__tips">验证码已发送至 +86 {{maskedPhone}}</view>

  <view class="login-code__input">
    <t-input maxlength="6" placeholder="请输入 6 位验证码" value="{{verifyCode}}" type="number" bindchange="onVerifyCodeChange">
      <view slot="suffix" class="suffix">
        <view class="suffix--line" />
        <t-link
          size="medium"
          hover
          disabled="{{sendCodeCount > 0 || sending}}"
          theme="primary"
          content="{{sendCodeCount > 0 ? sendCodeCount + ' 秒后重发' : '重新发送'}}"
          bindtap="resendCode"
        />
      </view>
    </t-input>
  </view>

  <view wx:if="{{isMock}}" class="login-code__mock-tip">当前为演示模式，请输入验证码 123456</view>

  <view class="login-code__button">
    <t-button theme="primary" size="large" block loading="{{submitting}}" disabled="{{verifyCode.length !== 6}}" bindtap="login">
      验证并登录
    </t-button>
  </view>
</view>
<t-toast id="code-toast" />
