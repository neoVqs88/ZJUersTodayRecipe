<view class="detail-page {{appearanceClass}}">
  <view class="figma-page-head-wrap"><figma-page-head title="{{title}}" subtitle="COMMUNITY MESSAGES" /></view>
  <scroll-view class="detail" scroll-y lower-threshold="100" bindscrolltolower="loadMore">
  <view class="msg" wx:for="{{messages}}" wx:key="_id">
    <image wx:if="{{item.senderAvatar}}" class="msg__avatar" src="{{item.senderAvatar}}" mode="aspectFill" data-user-id="{{item.actorUserId}}" bindtap="openSenderProfile" />
    <view wx:else class="msg__avatar" style="background: {{item.avatarColor}}" data-user-id="{{item.actorUserId}}" bindtap="openSenderProfile">{{item.senderInitial}}</view>
    <view class="msg__body">
      <view class="msg__row">
        <text class="msg__name" data-user-id="{{item.actorUserId}}" bindtap="openSenderProfile">{{item.senderName}}</text>
        <text class="msg__time">{{item.displayTime}}</text>
      </view>
      <view class="msg__action">{{item.action}}</view>
      <view wx:if="{{item.content}}" class="msg__content">{{item.content}}</view>
      <view wx:if="{{item.targetDesc}}" class="msg__target">原动态：{{item.targetDesc}}</view>
    </view>
    <view wx:if="{{!item.read}}" class="msg__dot"></view>
  </view>

  <view wx:if="{{!loading && messages.length === 0}}" class="detail__empty">这个分类还没有消息</view>
  <view wx:if="{{loadingMore}}" class="detail__empty">正在加载更多…</view>
  </scroll-view>
</view>
