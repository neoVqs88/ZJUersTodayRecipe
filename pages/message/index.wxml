<view class="message-page {{appearanceClass}}"><scroll-view class="message-scroll" scroll-y enhanced show-scrollbar="{{false}}" lower-threshold="120" bindscrolltolower="loadMore">
  <view class="detail-head"><text class="back" bindtap="goBack">‹</text><view><text>消息</text><text>TABLEMATE · SYSTEM · COMMUNITY</text></view><text class="read-all" bindtap="markAllRead">全部已读</text></view>
  <view class="message-tabs"><view class="{{activeTab === 'all' ? 'active' : ''}}" data-tab="all" bindtap="switchMessageTab">全部</view><view class="{{activeTab === 'dining' ? 'active' : ''}}" data-tab="dining" bindtap="switchMessageTab">饭局</view><view class="{{activeTab === 'interaction' ? 'active' : ''}}" data-tab="interaction" bindtap="switchMessageTab">互动</view><view class="{{activeTab === 'system' ? 'active' : ''}}" data-tab="system" bindtap="switchMessageTab">系统</view></view>
  <view class="unread-card"><view><text>今天</text><text>{{unreadTotal}} 条未读</text></view><view><text>饭局快开始了</text><text>优先查看时间变动</text></view></view>
  <text class="section-label">刚才的消息</text>
  <view class="message-card {{index === displayCards.length - 1 ? 'soft' : ''}}" wx:for="{{displayCards}}" wx:key="category" data-category="{{item.category}}" data-title="{{item.title}}" bindtap="openCategory"><view class="letter letter--{{item.theme}}"><t-icon name="{{item.icon}}" size="34rpx" /></view><view class="message-copy"><text>{{item.title}}</text><text>{{item.detail || item.summary}}</text></view><view class="message-meta"><text>{{item.displayTime}}</text><text wx:if="{{item.unreadCount}}"></text><text>›</text></view></view>
  <view wx:if="{{!loading && !displayCards.length}}" class="message-empty"><text>暂时没有新消息</text></view>
  <view wx:if="{{loadingMore}}" class="message-empty"><text>正在加载更多…</text></view>
  <text class="message-foot">只保留必要提醒；通知偏好可在“我的”中调整</text><view class="bottom-space"></view>
</scroll-view></view>
