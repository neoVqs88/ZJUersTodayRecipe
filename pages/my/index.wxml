<view class="my-page {{appearanceClass}}">
  <image class="my-page__background" src="/static/bg_navbar.png" mode="aspectFill" />
  <nav title-text="我的" />

  <scroll-view class="my-page__scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="profile-card">
      <view class="profile-card__main" wx:if="{{isLoggedIn}}" bindtap="openMyProfile">
        <t-avatar image="{{personalInfo.image}}" size="128rpx" />
        <view class="profile-card__copy">
          <view class="profile-card__name-row">
            <text class="profile-card__name">{{personalInfo.name || 'zjuer'}}</text>
            <t-tag size="small" variant="light" theme="primary" icon="education">{{personalInfo.star || '浙江大学生'}}</t-tag>
          </view>
          <view class="profile-card__intro">{{personalInfo.introduction || personalInfo.brief || '吃好每一餐，记录校园好食光 ✨'}}</view>
        </view>
        <view class="profile-card__edit" catchtap="editProfile">编辑资料 <t-icon name="chevron-right" /></view>
      </view>

      <view class="profile-card__main profile-card__guest" wx:else bindtap="requireLogin">
        <t-avatar icon="user" size="128rpx" />
        <view class="profile-card__copy">
          <view class="profile-card__name">登录 / 注册</view>
          <view class="profile-card__intro">登录后记录三餐，发现更多校园美食</view>
        </view>
        <t-icon name="chevron-right" size="36rpx" />
      </view>

      <view class="stats">
        <view class="stats__item" wx:for="{{stats}}" wx:key="label" data-item="{{item}}" bindtap="handleStatTap">
          <view class="icon-box icon-box--{{item.color}}"><t-icon name="{{item.icon}}" size="40rpx" /></view>
          <view class="stats__copy">
            <view class="stats__label">{{item.label}}</view>
            <view class="stats__value">{{item.value}} <text>{{item.unit}}</text></view>
          </view>
        </view>
      </view>
    </view>

    <view class="my-progress-wrap">
      <checkin-progress
        count="{{weeklyCheckInCount}}"
        goal="{{weeklyGoal}}"
        subtitle="连续打卡 {{streakDays}} 天，坚持记录三餐"
        dark="{{isDarkMode}}"
        bind:tap="openCheckinHistory"
      />
    </view>

    <view class="menu-card" wx:for="{{menuGroups}}" wx:for-item="group" wx:key="index">
      <view class="menu-row" wx:for="{{group}}" wx:key="type" data-item="{{item}}" bindtap="handleMenuTap">
        <view class="icon-box icon-box--{{item.color}}"><t-icon name="{{item.icon}}" size="38rpx" /></view>
        <text class="menu-row__title">{{item.name}}</text>
        <text wx:if="{{item.note}}" class="menu-row__note">{{item.note}}</text>
        <t-icon name="chevron-right" size="36rpx" color="{{isDarkMode ? '#667085' : '#98a2b3'}}" />
      </view>
    </view>
    <view class="my-page__bottom-space" />
  </scroll-view>
</view>
