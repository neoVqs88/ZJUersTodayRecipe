<view class="my-page {{appearanceClass}}">
  <scroll-view class="my-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="my-head"><text>我的饭纹</text><text>你吃过的，会慢慢长成一种性格。</text></view>
    <view class="profile-row" bindtap="openMyProfile"><image wx:if="{{personalInfo.avatarUrl}}" src="{{personalInfo.avatarUrl}}" mode="aspectFill"/><view wx:else class="avatar-fallback">ZJ</view><view class="profile-copy"><text>{{isLoggedIn ? (personalInfo.nickName || personalInfo.name || '浙里饭友 072') : '登录后生成你的饭纹'}}</text><text>{{isLoggedIn ? ('连续记录 ' + streakDays + ' 天 · ' + (personalInfo.campus || '玉泉')) : '微信登录 · 云端同步'}}</text><view catchtap="editProfile">⌁ 编辑偏好</view></view></view>
    <view class="stats-card"><view><text>{{personalInfo.checkInCount || 0}}</text><text>本月餐次</text></view><view><text class="orange">{{weeklyCheckInCount}}</text><text>食堂足迹</text></view><view><text>{{streakDays}}</text><text>连续天数</text></view></view>
    <view class="taste-card"><view class="taste-head"><view><text>味觉指纹</text><text>每一格，都是一餐留下的偏好痕迹</text></view><text>最近 30 天</text></view><view class="taste-row" wx:for="{{tasteBars}}" wx:key="label"><text>0{{index+1}}</text><text>{{index === 0 ? '清淡' : index === 1 ? '微辣' : '甜口'}}</text><view><text style="width:{{item.value}}%"></text></view><text>{{index === 0 ? '42%' : index === 1 ? '31%' : '18%'}}</text></view><text class="taste-caption">TASTE INDEX · 91% OF RECORDED MEALS</text></view>
    <view class="feedback-row" bindtap="handleMenuTap" data-item="{{menuGroups[1][3]}}">遇到问题？提交反馈或申诉　→</view>
    <view class="settings-grid"><view wx:for="{{menuGroups[1]}}" wx:key="name" data-item="{{item}}" bindtap="handleMenuTap"><text>{{item.name}}</text><text>{{item.name === '管理入口' ? '验证' : item.name === '隐私与通知' ? '已开启' : '→'}}</text></view><view data-item="{{menuGroups[0][0]}}" bindtap="handleMenuTap"><text>收藏与关注</text><text>20 项</text></view></view>
    <view class="nav-space"></view>
  </scroll-view><figma-nav active="my" />
</view>
