<view class="my-page {{appearanceClass}}">
  <scroll-view class="my-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="my-head"><text>我的饭纹</text><text>你吃过的，会慢慢长成一种性格。</text></view>
    <view class="profile-row" bindtap="openMyProfile"><image wx:if="{{personalInfo.avatarUrl || personalInfo.image}}" src="{{personalInfo.avatarUrl || personalInfo.image}}" mode="aspectFill"/><view wx:else class="avatar-fallback">ZJ</view><view class="profile-copy"><text>{{isLoggedIn ? (personalInfo.nickName || personalInfo.name || '浙里饭友 072') : '登录后生成你的饭纹'}}</text><text>{{isLoggedIn ? ('连续记录 ' + streakDays + ' 天 · ' + (personalInfo.campus || '玉泉')) : '微信登录 · 云端同步'}}</text><view catchtap="editProfile">⌁ 编辑偏好</view></view></view>
    <view class="stats-card"><view><text>{{personalInfo.checkInCount || 0}}</text><text>累计餐次</text></view><view><text class="orange">{{weeklyCheckInCount}}</text><text>本周打卡</text></view><view><text>{{streakDays}}</text><text>连续天数</text></view></view>
    <view class="taste-card"><view class="taste-head"><view><text>本周用餐节奏</text><text>早餐、午餐与晚餐的记录分布</text></view><text>近 7 天</text></view><view class="taste-row" wx:for="{{tasteBars}}" wx:key="label"><text>0{{index+1}}</text><text>{{item.label}}</text><view><text style="width:{{item.value}}%"></text></view><text>{{item.percent}}</text></view><text class="taste-caption">{{tasteCaption}}</text></view>
    <view class="feedback-row" bindtap="handleMenuTap" data-item="{{menuGroups[1][3]}}">遇到问题？提交反馈或申诉　→</view>
    <view class="settings-grid"><view wx:for="{{menuGroups[1]}}" wx:key="name" data-item="{{item}}" bindtap="handleMenuTap"><text>{{item.name}}</text><text>{{item.name === '管理入口' ? '验证' : item.name === '隐私与通知' ? '设置' : '→'}}</text></view><view data-item="{{menuGroups[0][0]}}" bindtap="handleMenuTap"><text>收藏与关注</text><text>{{socialCount}} 项</text></view></view>
    <view class="nav-space"></view>
  </scroll-view><figma-nav active="my" />
</view>
