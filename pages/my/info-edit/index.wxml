<view class="edit-page {{appearanceClass}}">
  <view class="edit-loading" wx:if="{{loading}}">正在读取个人资料…</view>
  <scroll-view class="edit-scroll" scroll-y enhanced show-scrollbar="{{false}}" wx:else>
    <view class="page-head">
      <view class="back" bindtap="goBack">‹</view>
      <view class="head-copy"><text>编辑资料</text><text>WHAT OTHERS MAY SEE</text></view>
      <view class="head-save" bindtap="saveProfile">{{saving ? '保存中' : '保存'}}</view>
    </view>
    <view class="avatar-editor">
      <view class="avatar-button" bindtap="chooseAvatarFromDevice"><image src="{{profile.image}}" mode="aspectFill"/><view class="camera">＋</view></view>
      <view class="avatar-copy"><text>换头像</text><text>建议使用能认出你的照片，<br/>搭桌确认后更容易见面。</text><text>校园认证不会公开学号</text><view><text bindtap="chooseAvatarFromDevice">相册 / 拍照</text><button open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">微信头像</button></view></view>
    </view>
    <view class="deep-heading">基本资料</view>
    <view class="form-card">
      <view class="form-row"><view><text>昵称</text><input type="nickname" maxlength="20" value="{{profile.name}}" placeholder="请输入昵称" data-field="name" bindinput="onFieldInput"/></view></view>
      <view class="form-row form-row--bio"><view><text>个人简介</text><textarea maxlength="80" value="{{profile.introduction}}" placeholder="介绍一下你的口味、常去食堂或想找的饭搭子" data-field="introduction" bindinput="onFieldInput"/></view><text>{{profile.introduction.length}}/80</text></view>
    </view>
    <view class="deep-heading">校园身份</view>
    <view class="form-card soft-card">
      <picker mode="selector" range="{{campusOptions}}" value="{{campusIndex}}" data-field="campus" bindchange="onPickerChange"><view class="form-row"><view><text>所在校区</text><text>{{profile.campus}}</text></view><text>›</text></view></picker>
      <view class="form-row"><view><text>院系</text><input maxlength="30" value="{{profile.college}}" placeholder="例如：计算机科学与技术学院" data-field="college" bindinput="onFieldInput"/></view></view>
      <picker mode="selector" range="{{gradeOptions}}" value="{{gradeIndex}}" data-field="grade" bindchange="onPickerChange"><view class="form-row"><view><text>身份</text><text>{{profile.grade}}</text></view><text>›</text></view></picker>
      <picker mode="selector" range="{{genderOptions}}" value="{{genderIndex}}" data-field="gender" bindchange="onPickerChange"><view class="form-row"><view><text>性别</text><text>{{profile.gender}}</text></view><text>›</text></view></picker>
      <view class="form-row"><view><text>家乡</text><input maxlength="30" value="{{profile.hometown}}" placeholder="例如：浙江杭州" data-field="hometown" bindinput="onFieldInput"/></view></view>
    </view>
    <view class="deep-heading">搭桌资料</view>
    <view class="form-card soft-card preference-card"><text>饭桌偏好</text><text>最多选择 6 个</text><view class="taste-list"><view class="taste-item {{item.selected ? 'selected' : ''}}" wx:for="{{preferenceItems}}" wx:key="value" data-value="{{item.value}}" bindtap="togglePreference">{{item.value}}</view></view></view>
    <view class="sincerity"><text>资料诚意度 86%</text><view><view></view></view><text>继续完善资料，更容易找到合拍的饭搭子</text></view>
    <text class="bottom-note">这里只展示你主动填写的公开资料，不会展示手机号和微信身份信息。</text>
    <view class="bottom-save {{saving ? 'disabled' : ''}}" bindtap="saveProfile">{{saving ? '保存中…' : '保存资料'}}　›</view>
    <view class="bottom-space"></view>
  </scroll-view>
</view>
