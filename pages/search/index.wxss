.search-page{height:100vh;overflow:hidden;background:#f5f1e8;color:#1d2118;font-family:'Noto Serif SC','Songti SC',serif}.search-scroll{height:100%}.search-head{position:relative;padding:calc(125rpx + env(safe-area-inset-top)) 38rpx 0}.search-head__back{position:absolute;left:38rpx;top:calc(95rpx + env(safe-area-inset-top));font-size:44rpx}.search-head__title,.search-head__desc{display:block;margin-left:64rpx}.search-head__title{font-size:52rpx}.search-head__desc{margin-top:6rpx;color:#696c61;font-size:24rpx}.search-field{display:flex;align-items:center;height:78rpx;margin:30rpx 38rpx 0;padding:0 24rpx;border-radius:24rpx;background:#fffcf6;box-shadow:0 4rpx 12rpx rgba(31,33,23,.08)}.search-field input{flex:1;font-size:24rpx}.quick-scroll{margin-top:22rpx;white-space:nowrap}.quick-list{display:inline-flex;gap:12rpx;padding:0 38rpx}.quick-list view,.memory__words text{padding:8rpx 16rpx;border-radius:24rpx;background:#ebebec;font-size:20rpx}.memory{margin:28rpx 38rpx 0;padding:34rpx;border-radius:44rpx;background:#e7eee4}.memory text{display:block}.memory__eyebrow{color:#ff6b4a;font-size:17rpx}.memory__title{margin-top:14rpx;font-size:34rpx}.memory__desc,.memory__hint{margin-top:6rpx;color:#696c61;font-size:19rpx}.memory__words{display:flex;gap:14rpx;margin-top:22rpx}.memory__divider{height:1rpx;margin:28rpx 0;background:#cdd5ca}.memory__hint-title{font-size:23rpx}.section-head{display:flex;justify-content:space-between;margin:50rpx 38rpx 18rpx}.section-head text:first-child{font-size:32rpx}.section-head text:last-child{color:#696c61;font-size:19rpx}.hot-list,.result-list{margin:0 38rpx}.hot-list>view,.result-list>view{display:flex;align-items:center;min-height:112rpx;margin-bottom:14rpx;padding:0 22rpx;border-radius:34rpx;background:#fffcf6}.hot-list>view:nth-child(2n),.result-list>view:nth-child(2n){background:#e7eee4}.hot-list>view text:first-child{width:60rpx;color:#ff6b4a}.hot-list>view text:nth-child(2){flex:1;font-size:24rpx}.hot-list>view text:last-child{color:#ff6b4a}.best{display:flex;margin:32rpx 38rpx;padding:28rpx;border-radius:42rpx;background:#fffcf6}.best__copy{display:flex;flex:1;flex-direction:column}.best__eyebrow{color:#ff6b4a;font-size:17rpx}.best__name{margin-top:12rpx;font-size:34rpx}.best__desc,.best__meta{margin-top:8rpx;color:#696c61;font-size:19rpx}.best image{width:180rpx;height:180rpx;border-radius:50%}.result-list>view image{width:80rpx;height:80rpx;border-radius:50%}.result-list>view>view{display:flex;flex:1;flex-direction:column;margin-left:18rpx}.bottom-space{height:150rpx}
