<view class="setting-page {{appearanceClass}}">
  <scroll-view class="setting-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="page-head"><view class="back" bindtap="goBack">‹</view><view class="head-copy"><text>设置</text><text>PROFILE · PRIVACY · DATA</text></view></view>
    <view class="settings-card">
      <view class="setting" bindtap="chooseFontSize"><view><text>字体大小</text><text>当前：{{fontSizeLabel}}</text></view><text>›</text></view>
      <view class="hairline"></view>
      <view class="setting" bindtap="openPrivacy"><view><text>隐私可见范围</text><text>谁能看见饭纹、动态与足迹</text></view><text>›</text></view>
    </view>
    <text class="section-title">通知与外观</text>
    <view class="settings-card soft-card">
      <view class="setting"><view><text>深色模式</text><text>减少暗光环境下的视觉刺激</text></view><switch checked="{{darkMode}}" color="#ff6b4a" bindchange="toggleDarkMode"/></view>
      <view class="hairline"></view>
      <view class="setting"><view><text>饭局与回复</text><text>站内未读提醒和消息红点</text></view><switch checked="{{notificationsEnabled}}" color="#ff6b4a" bindchange="toggleNotifications"/></view>
    </view>
    <text class="section-title">账户与数据</text>
    <view class="settings-card">
      <view class="setting" bindtap="clearCache"><view><text>清理缓存</text><text>搜索记录与本地临时草稿</text></view><text>›</text></view>
      <view class="hairline"></view>
      <view class="setting" data-type="agreement" bindtap="openLegal"><view><text>用户协议</text><text>服务规则与用户行为规范</text></view><text>›</text></view>
      <view class="hairline"></view>
      <view class="setting" data-type="privacy" bindtap="openLegal"><view><text>隐私政策</text><text>个人信息的收集、使用与保护</text></view><text>›</text></view>
    </view>
    <view wx:if="{{loggedIn}}" class="logout-action" bindtap="logout">退出当前登录</view>
    <view wx:if="{{loggedIn}}" class="danger-card"><view><text>注销账号</text><text>永久删除账号及其云端个人数据</text></view><button loading="{{deletingAccount}}" bindtap="deleteAccount">注销</button></view>
    <text class="version">zjuer 今天吃什么 · 1.0.0</text><view class="bottom-space"></view>
  </scroll-view>
</view>
