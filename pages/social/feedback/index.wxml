<view class="feedback-page {{appearanceClass}}"><t-navbar title="意见反馈" left-arrow /><view class="feedback-card"><text class="feedback-title">告诉我们哪里可以做得更好</text><textarea maxlength="800" value="{{content}}" bindinput="onContent" placeholder="功能建议、使用问题或想看到的新内容…" /><input maxlength="100" value="{{contact}}" bindinput="onContact" placeholder="联系方式（选填）" /><button loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">提交反馈</button></view></view>
