<view class="feedback-page {{appearanceClass}}">
  <scroll-view class="feedback-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="page-head"><view class="back" bindtap="goBack">‹</view><view class="head-copy"><text>反馈与申诉</text><text>TELL THE TEAM</text></view></view>
    <view class="feedback-hero"><view>?</view><view><text>反馈给管理团队</text><text>问题、建议与处罚申诉，都会进入同一处理队列。</text></view></view>
    <view class="feedback-card">
      <view class="feedback-heading">
        <text class="feedback-eyebrow">仅管理团队可见</text>
        <text class="feedback-title">告诉我们哪里可以做得更好</text>
        <text class="feedback-subtitle">使用问题、功能建议和体验感受都可以告诉我们。</text>
      </view>
      <textarea
        class="feedback-content"
        maxlength="800"
        value="{{content}}"
        bindinput="onContent"
        placeholder="功能建议、使用问题或想看到的新内容…"
        adjust-position="{{true}}"
        disable-default-padding="{{true}}"
      />
      <view class="feedback-count">{{content.length}} / 800</view>
      <view class="feedback-upload-title"><text>添加截图</text><text>最多 4 张，帮助我们更快定位问题</text></view>
      <t-upload
        media-type="{{['image']}}"
        files="{{originFiles}}"
        grid-config="{{gridConfig}}"
        config="{{uploadConfig}}"
        max="4"
        size-limit="{{10240}}"
        bind:success="handleUploadSuccess"
        bind:remove="handleUploadRemove"
      />
      <input
        class="feedback-contact"
        maxlength="100"
        value="{{contact}}"
        bindinput="onContact"
        placeholder="联系方式（选填）"
        adjust-position="{{true}}"
      />
      <button class="feedback-submit" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">提交反馈</button>
    </view>
    <view class="feedback-bottom-space" />
  </scroll-view>
</view>
